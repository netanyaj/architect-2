flowchart TB
  subgraph USER["People"]
    direction LR
    UI["Architect web app<br/>Parts panel · stage · chat"]
    PV["Live preview<br/>the app as it's built"]
    CA["Your coding agent<br/>Claude Code · Cursor (via MCP)"]
  end
  subgraph GOV["Governance layer"]
    direction LR
    POL["Policies<br/>models · apps · data and egress · budgets"]
    APR["Approvals and allow-rules"]
    AUD["Audit log"]
  end
  subgraph CP["Control plane"]
    direction LR
    GW["API gateway<br/>one entry · sign-in · workspaces"]
    SVC["Plan service<br/>parts · checks · cost"]
    ORCH["Run orchestrator<br/>durable workflows"]
    RT["Realtime hub<br/>live events"]
  end
  subgraph DP["Data plane · Lyzr Cloud or your VPC"]
    direction LR
    WK["Architect agent and<br/>verifier workers"]
    SB["Sandbox per project<br/>your stack + daemon"]
    PX["Preview proxy"]
    MGW["Model gateway"]
    GIT["Git executor"]
    PS[("Project store")]
    APPS["App runtime<br/>Test version · Team version · Live"]
    EGR["Egress proxy<br/>injects secrets"]
  end
  subgraph LS["Lyzr Studio · per workspace"]
    direction LR
    STU["Agent runtime and registry<br/>your app's agents · evals · reuse"]
  end
  EXT["Model providers · GitHub · your apps, MCP servers and keys"]
  UI --> GW
  CA --> GW
  RT -. live events .-> UI
  PV --> PX --> SB
  GW --> SVC
  GW --> ORCH
  ORCH --> WK
  ORCH --> APPS
  WK --> SB
  WK --> MGW
  WK --> GIT
  WK --> PS
  WK -. status .-> RT
  WK -- agents made when their part works --> STU
  APPS -- app agents run on --> STU
  SB --> EGR
  APPS --> EGR
  EGR --> EXT
  MGW --> EXT
  GIT --> EXT
  POL -. checked before every action that leaves a sandbox .-> ORCH
  APR -. holds Live, keys, new apps .-> ORCH
  ORCH -. writes .-> AUD
  classDef gov fill:#F0EAFA,stroke:#6236AD;
  classDef cp fill:#EEF2FF,stroke:#4F46E5;
  classDef dp fill:#ECFEFF,stroke:#0891B2;
  classDef ls fill:#E2E8DC,stroke:#3E6B48;
  classDef ext fill:#F3F4F6,stroke:#9CA3AF;
  class POL,APR,AUD gov; class GW,SVC,ORCH,RT cp; class WK,MGW,SB,EGR,GIT,PS,PX,APPS dp; class STU ls; class EXT ext;
