# Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Model gateway (server only). Free setup: Gemini is required; OpenRouter is optional.
# Claude and GPT stay in the picker. With no key they are tagged "Simulated" and answered by Gemini.
# Add ANTHROPIC_API_KEY / OPENAI_API_KEY later and they become real with no code change.
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Model ids are config, not code: set them to current models.
# Use a flash-lite Gemini model on the free tier (e.g. gemini-3.5-flash-lite): the newest full flash models allow
# only ~20 requests a day free, which plans, chat and Help use up quickly.
MODEL_GEMINI=
MODEL_OPENROUTER=        # a ":free" model with structured output, e.g. nvidia/nemotron-3-super-120b-a12b:free (~25 s per plan)
MODEL_CLAUDE=
MODEL_GPT=

# GitHub App (read-only contents + metadata)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Lyzr Studio: app agents run here for real (Agents › Try it). Without a key, Try it uses the model gateway (Simulated).
LYZR_API_KEY=
# A generic Studio agent, used only if an agent can't be created per node.
LYZR_AGENT_ID=
